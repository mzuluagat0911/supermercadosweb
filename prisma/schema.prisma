generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Brand {
  EL_AHORRO
  DEL_CENTRO
}

enum CtaType {
  OFFERS
  WHATSAPP
  STORES
  CATALOG
  LINK
}

model Banner {
  id        String   @id @default(cuid())
  tag       String?
  title     String
  body      String
  imageUrl  String
  ctaText   String
  ctaLink   String?
  ctaType   CtaType  @default(LINK)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id        String   @id @default(cuid())
  brand     Brand
  name      String
  slug      String   @unique
  address   String
  phone     String
  whatsapp  String
  mapsUrl   String?
  imageUrl  String?
  latitude  Float
  longitude Float
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AboutContent {
  id          String   @id @default("default")
  vision      String
  mission     String
  description String
  imageUrl    String?
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id           String   @id @default("default")
  contactEmail String
  instagramUrl String?
  facebookUrl  String?
  updatedAt    DateTime @updatedAt
}

model HrArea {
  id        String  @id @default(cuid())
  name      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model HrApplication {
  id         String   @id @default(cuid())
  fullName   String
  phone      String
  email      String
  area       String
  message    String?
  cvFileName String?
  cvUrl      String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
